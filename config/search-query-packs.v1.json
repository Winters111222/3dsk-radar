      1,
      7,
      30
    ],
    "older_records": "Require independent evidence of still accepting; last_crawled is not publication or acceptance.",
    "site_scoping": "Use verified source domain/category. Official API adapters use native filters, not search-engine query strings.",
    "hard_reject_semantics": [
      "seller_only",
      "closed_or_filled",
      "awarded_or_cancelled",
      "unpaid_only",
      "revshare_only",
      "equipment_only",
      "geospatial_or_bim_only",
      "geo_ineligible"
    ],
    "notes": "Do not globally minus paid/for hire/closed words: mixed headings, negations and useful stale buyer signals require body-level classification."
