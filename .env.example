# Server-side only. Secret values must be set in Netlify environment variables, never committed.
OPENAI_API_KEY=
RADAR_INTERNAL_ACCESS_SECRET=

# Non-secret Stage 2 tuning. Override in Netlify only when needed.
OPENAI_SEARCH_MODEL=gpt-5.6-luna
RADAR_SEARCH_MAX_RESULTS=12
RADAR_SEARCH_COOLDOWN_SECONDS=30
