# Server-side only. Never expose values to browser code or commit real secrets.
OPENAI_API_KEY=
RADAR_INTERNAL_ACCESS_SECRET=

# Keep false until the entire app passes zero-cost acceptance.
RADAR_LIVE_AI_ENABLED=false
RADAR_SOURCE_COLLECTION_ENABLED=false
RADAR_SOURCE_COLLECTION_MAX_RESULTS=25
RADAR_SOURCE_COLLECTION_COOLDOWN_SECONDS=10

# Cost/runtime controls.
OPENAI_SEARCH_MODEL=gpt-5.6-luna
OPENAI_REPLY_MODEL=gpt-5.6-sol
RADAR_SEARCH_MAX_RESULTS=12
RADAR_SEARCH_COOLDOWN_SECONDS=30

# Production paid actions remain independently locked. Production Search is
# server-owned, production-only and limited to one idempotent run per UTC day.
RADAR_PRODUCTION_SEARCH_ENABLED=false
RADAR_PRODUCTION_SEARCH_PROFILE=FOCUSED
RADAR_PRODUCTION_SEARCH_MAX_USD=0.50
RADAR_PRODUCTION_SEARCH_MAX_RESULTS=6
# Alternative, separately reviewed production profile:
# RADAR_PRODUCTION_SEARCH_PROFILE=WIDE_INDEX
# RADAR_PRODUCTION_SEARCH_MAX_USD=2.00
# RADAR_PRODUCTION_SEARCH_MAX_RESULTS=24
# WIDE V3 is separately gated and uses the high-precision judge model:
# RADAR_PRODUCTION_SEARCH_PROFILE=WIDE_V3
# RADAR_PRODUCTION_SEARCH_MAX_USD=3.00
# RADAR_PRODUCTION_SEARCH_MAX_RESULTS=32
# Optional WIDE v2 pre-discovery. Keep locked until an exact Git-backed
# acceptance. FIRECRAWL_API_KEY is server-side only; 5 requests, 26 credits,
# no retry. This never enables login, CAPTCHA handling or arbitrary URLs.
FIRECRAWL_API_KEY=
RADAR_FIRECRAWL_WIDE_ENABLED=false
RADAR_FIRECRAWL_MAX_CREDITS=26
RADAR_PRODUCTION_REPLY_ENABLED=false

# WIDE V3 official source connectors. These remain independent default-off
# gates. The dispatcher accepts WIDE_V3 only with its exact hard limits and at
# least one configured official adapter. Never commit real tokens or IDs.
RADAR_UPWORK_API_ENABLED=false
UPWORK_OAUTH_ACCESS_TOKEN=
UPWORK_API_TENANT_ID=
RADAR_REDDIT_API_ENABLED=false
REDDIT_OAUTH_ACCESS_TOKEN=
RADAR_BLUESKY_SEARCH_ENABLED=false
RADAR_MASTODON_SEARCH_ENABLED=false
MASTODON_API_ORIGIN=
MASTODON_ACCESS_TOKEN=
RADAR_LINKEDIN_SIGNAL_ENABLED=false
RADAR_SOURCE_INGEST_SECRET=
RADAR_SOURCE_SIGNAL_INGEST_ENABLED=false
RADAR_TELEGRAM_SOURCE_ENABLED=false
TELEGRAM_SOURCE_BOT_TOKEN=
TELEGRAM_SOURCE_ALLOWED_CHATS=
RADAR_DISCORD_SOURCE_ENABLED=false
DISCORD_SOURCE_BOT_TOKEN=
DISCORD_SOURCE_ALLOWED_CHANNELS=
RADAR_X_SEARCH_ENABLED=false
X_API_BEARER_TOKEN=
RADAR_OFFICIAL_SOURCE_DISCOVERY_ENABLED=false
RADAR_OFFICIAL_SOURCE_MAX_REQUESTS=
RADAR_OFFICIAL_SOURCE_CANARY_ENABLED=false
RADAR_OFFICIAL_SOURCE_CANARY_PROFILE=
RADAR_OFFICIAL_SOURCE_CANARY_MAX_REQUESTS=

# Temporary isolated pre-live test workspace. Keep false outside acceptance.
RADAR_PRELIVE_ACCEPTANCE_ENABLED=false

# Single-use paid acceptance. Keep disabled except for an explicitly approved
# immutable Deploy Preview backed by its isolated Netlify Database branch.
# Scope these five variables to deploy-preview only.
RADAR_ACCEPTANCE_PROFILE=
RADAR_PAID_ACCEPTANCE_ENABLED=false
RADAR_PAID_ACCEPTANCE_RUN_ID=
RADAR_PAID_ACCEPTANCE_MAX_USD=0.50
RADAR_PAID_ACCEPTANCE_MAX_RESULTS=6
