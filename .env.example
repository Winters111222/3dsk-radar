# Server-side only. Never expose values to browser code or commit real secrets.
OPENAI_API_KEY=
RADAR_INTERNAL_ACCESS_SECRET=

# Keep false until the entire app passes zero-cost acceptance.
RADAR_LIVE_AI_ENABLED=false
RADAR_SOURCE_COLLECTION_ENABLED=false
RADAR_SOURCE_COLLECTION_MAX_RESULTS=25
RADAR_SOURCE_COLLECTION_COOLDOWN_SECONDS=10

# Cost/runtime controls.
OPENAI_SEARCH_MODEL=gpt-5.6-luna
OPENAI_REPLY_MODEL=gpt-5.6-sol
RADAR_SEARCH_MAX_RESULTS=12
RADAR_SEARCH_COOLDOWN_SECONDS=30

# Temporary isolated pre-live test workspace. Keep false outside acceptance.
RADAR_PRELIVE_ACCEPTANCE_ENABLED=false
