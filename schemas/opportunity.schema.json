{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3D.SK Opportunity Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id","canonical_url","source_url","source_domain","title","company","summary","opportunity_kind","categories","location","remote_scope","published_date","first_seen","last_seen","is_new","status","fit_score","win_score","win_band","budget_type","budget_published","budget_estimated_min","budget_estimated_max","budget_currency","budget_confidence","budget_reason","contact_name","contact_role","contact_email","contact_email_source","apply_url","why_it_fits","risks","missing_requirements","source_evidence"
  ],
  "properties": {
    "id":{"type":"string","minLength":1},
    "is_fixture":{"type":"boolean"},
    "canonical_url":{"type":"string","format":"uri"},
    "source_url":{"type":"string","format":"uri"},
    "source_domain":{"type":"string","minLength":1},
    "title":{"type":"string","minLength":1},
    "company":{"type":"string","minLength":1},
    "summary":{"type":"string","minLength":1},
    "opportunity_kind":{"enum":["OPEN_OPPORTUNITY","POTENTIAL_LEAD"]},
    "categories":{"type":"array","minItems":1,"maxItems":6,"uniqueItems":true,"items":{"enum":["FULL_PIPELINE","CAPTURE","PHOTOGRAMMETRY_PROCESSING","SCAN_CLEANUP","WRAP_BASEMESH","FACIAL_FACS","CHARACTER_FINISHING","CHARACTER_OUTSOURCING","EXTERNAL_DEVELOPMENT","PRODUCTION_OVERFLOW","PIPELINE_CONSULTING","VISUAL_AI_MOTION","OTHER_RELEVANT"]}},
    "location":{"type":"string"},
    "remote_scope":{"enum":["WORLDWIDE_VENDOR","GLOBAL_REMOTE","REMOTE_REGION","LOCATION_RESTRICTED","ONSITE","NOT_STATED"]},
    "published_date":{"type":["string","null"]},
    "first_seen":{"type":"string"},
    "last_seen":{"type":"string"},
    "is_new":{"type":"boolean"},
    "status":{"enum":["NEW","INTERESTING","CONTACTED","IGNORE"]},
    "fit_score":{"type":"integer","minimum":0,"maximum":100},
    "win_score":{"type":"integer","minimum":0,"maximum":100},
    "win_band":{"enum":["HIGH","MEDIUM","LOW"]},
    "budget_type":{"enum":["PUBLISHED","ESTIMATED","UNKNOWN"]},
    "budget_published":{"type":["string","null"]},
    "budget_estimated_min":{"type":["number","null"]},
    "budget_estimated_max":{"type":["number","null"]},
    "budget_currency":{"type":["string","null"]},
    "budget_confidence":{"type":["string","null"]},
    "budget_reason":{"type":"string"},
    "contact_name":{"type":["string","null"]},
    "contact_role":{"type":["string","null"]},
    "contact_email":{"type":["string","null"]},
    "contact_email_source":{"type":["string","null"]},
    "apply_url":{"type":"string","format":"uri"},
    "why_it_fits":{"type":"array","items":{"type":"string"}},
    "risks":{"type":"array","items":{"type":"string"}},
    "missing_requirements":{"type":"array","items":{"type":"string"}},
    "source_evidence":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["type","url","note"],"properties":{"type":{"enum":["PRIMARY_SOURCE","SECONDARY_SOURCE","CONTACT_SOURCE","SIGNAL_SOURCE","PRIMARY_FIXTURE","SIGNAL_FIXTURE"]},"url":{"type":"string","format":"uri"},"note":{"type":"string"}}}}
  }
}
